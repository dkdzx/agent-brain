    B8{"Publish Version Gate<br/>expected_view_version<br/>equals current?"}
    B1 --> B2
    B1 -->|"context at each turn"| B5
    B5 -->|"acknowledge read version"| B7
    B1 -->|"post / resolve"| B8
    B7 --> B8
    B5 --> B8
    B8 -->|"fresh: append"| B3
    B8 -->|"stale: reject and reread"| B5
    B3 --> B4 --> B5
    B1 --> B6
  end

  subgraph C["Long-term Memory"]
    C1["Session Archive<br/>manifest + source snapshot"]
    C2["Candidate Extraction<br/>classify + extract"]
    C3["Temporal Merge<br/>merge + authority manifest"]
    C4["Long-term Memory Bundle<br/>CORE + Superindices + Supersedes"]
    C5["query_long_term_memory.py /<br/>verify_long_term_memory_bundle.py"]
