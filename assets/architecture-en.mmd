    C1 --> C2 --> C3 --> C4 --> C5
    C4 -.-> C6
  end

  subgraph D["Authority and Observability"]
    D1["Project Authority<br/>framework / gate / decision / handoff"]
    D2["Incomplete Causal Index<br/>CAUSAL_GRAPH + DSM + coverage / gaps"]
    D3["Controller Review<br/>pending review"]
