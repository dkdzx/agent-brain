    A1 --> A2
    A1 --> A3
    A2 --> A4
  end

  subgraph B["Temporary Workgroup Shared State"]
    B1["workgroup_brain.py<br/>create / context / post / resolve"]
    B2["members.json<br/>Members, Permissions, Lease Hash"]
    B3["events.jsonl<br/>Append-only + File Lock + Hash Chain"]
    B4["Reducer<br/>fsync + os.replace"]
    B5["view.json<br/>Rebuildable View"]
    B6["freeze / handoff / close<br/>FROZEN_SNAPSHOT + STABLE_HANDOFF"]
