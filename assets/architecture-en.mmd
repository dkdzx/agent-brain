    D1 --> D2
    D3 --> D1
  end

  A4 --> B1
  A3 -. "Lifecycle Reconciliation" .-> B6
  C5 -->|"Frozen Memory Slice"| B1
  D1 -->|"Authority Hash"| B1
  D2 -->|"Related Task Causal Slice"| B1
  B6 -->|"Unreviewed Group-memory Candidates"| D3
  D3 -->|"Approved Only"| C3
  B2 -. "Read-only Member Projection" .-> D4

  E1["verify_workgroup_brain.py<br/>Independent Validation"]
  E2["Wrong Identity, Duplicate Membership,<br/>Stale Context, Overreach, Expired Lease,<br/>and Post-freeze Writes All Fail Closed"]
  B6 --> E1 --> E2

